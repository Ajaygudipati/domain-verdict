# Required before production deployment
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_HOURS=168

# SQLite is used by default for local development. Use PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg2://domainverdict:change-me@db:5432/domainverdict

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: enables richer, report-grounded AI responses in Sentrynx AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Google Sign-In (optional). Create an OAuth 2.0 Web Client in Google Cloud,
# add your local/production origins, then set the same client ID in frontend/.env.
GOOGLE_CLIENT_ID=208415561515-rd7sd97n2abha188c8nt1hq8dj95et0m.apps.googleusercontent.com
